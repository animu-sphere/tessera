# Register execution and build membership together; imports build their own hosts.
function(tessera_add_check name target label)
    add_test(NAME ${name} COMMAND ${target} ${ARGN})
    set_tests_properties(${name} PROPERTIES LABELS ${label})
    if(label STREQUAL "contract" OR label STREQUAL "smoke")
        add_dependencies(tessera_pr_tests ${target})
    elseif(label STREQUAL "fixture")
        add_dependencies(tessera_fixture_tests ${target})
    elseif(label STREQUAL "native")
        add_dependencies(tessera_wide_tests ${target})
    else()
        message(FATAL_ERROR "Unknown Tessera check label '${label}' for ${name}")
    endif()
endfunction()

function(tessera_add_contract_test name source)
    add_executable(tessera_${name}_tests ${source})
    target_link_libraries(tessera_${name}_tests PRIVATE tessera::core)
    tessera_add_check(${name} tessera_${name}_tests contract)
endfunction()


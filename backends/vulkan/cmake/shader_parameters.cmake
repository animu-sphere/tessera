# Writes a shader parameter manifest from slangc reflection JSON (script mode).
#   cmake -DREFLECTION=<reflection.json> -DMANIFEST=<parameters.json> -DPROFILE=<fill-v1|sdf-v1>
#         -DSOURCE=<module.slang> -P shader_parameters.cmake
# The ABI macro declares `tesseraParameterDeclaration` with the module's Parameters struct. Each field
# must be a ProceduralNumber, ProceduralPoint or ProceduralColor, or for a procedural fill a
# ProceduralTexture; the manifest lists their names and kinds in slot order, in the canonical JSON that
# tessera::load_shader_parameters reads. A fill with one to three textures is written as fill-texture-v1.
foreach(variable IN ITEMS REFLECTION MANIFEST PROFILE SOURCE)
    if(NOT DEFINED ${variable})
        message(FATAL_ERROR "shader_parameters.cmake requires -D${variable}=...")
    endif()
endforeach()
file(READ "${REFLECTION}" reflection)
string(JSON count ERROR_VARIABLE problem LENGTH "${reflection}" parameters)
if(problem)
    message(FATAL_ERROR "${SOURCE}: unreadable slangc reflection (${problem}).")
endif()
set(declaration "")
if(count GREATER 0)
    math(EXPR last "${count} - 1")
    foreach(i RANGE ${last})
        string(JSON name GET "${reflection}" parameters ${i} name)
        if(name STREQUAL "tesseraParameterDeclaration")
            string(JSON declaration GET "${reflection}" parameters ${i} type)
        endif()
    endforeach()
endif()
if(declaration STREQUAL "")
    message(FATAL_ERROR "${SOURCE}: no parameter declaration; expand the profile's ABI macro once.")
endif()
string(JSON struct_name ERROR_VARIABLE problem GET "${declaration}" name)
string(JSON fields ERROR_VARIABLE problem LENGTH "${declaration}" fields)
if(problem)
    set(fields 0) # An empty Parameters struct reflects without fields.
endif()
if(fields GREATER 16)
    message(FATAL_ERROR "${SOURCE}: ${struct_name} declares ${fields} fields; declare at most 16 parameters.")
endif()
set(entries "")
set(textures 0)
if(fields GREATER 0)
    math(EXPR last "${fields} - 1")
    foreach(i RANGE ${last})
        string(JSON field GET "${declaration}" fields ${i} name)
        string(JSON type_kind GET "${declaration}" fields ${i} type kind)
        string(JSON type_name ERROR_VARIABLE problem GET "${declaration}" fields ${i} type name)
        if(problem) # Unnamed types: scalars by their scalar type, others (vector, array...) by kind.
            string(JSON type_name ERROR_VARIABLE problem GET "${declaration}" fields ${i} type scalarType)
            if(problem)
                set(type_name "${type_kind}")
            endif()
        endif()
        if(type_kind STREQUAL "struct" AND type_name STREQUAL "ProceduralNumber")
            set(kind number)
        elseif(type_kind STREQUAL "struct" AND type_name STREQUAL "ProceduralPoint")
            set(kind point)
        elseif(type_kind STREQUAL "struct" AND type_name STREQUAL "ProceduralColor")
            set(kind color)
        elseif(type_kind STREQUAL "struct" AND type_name STREQUAL "ProceduralTexture" AND PROFILE STREQUAL "fill-v1")
            set(kind texture)
            math(EXPR textures "${textures} + 1")
        else()
            message(FATAL_ERROR "${SOURCE}: ${struct_name}.${field} has type ${type_name}; declare each "
                "parameter as ProceduralNumber, ProceduralPoint or ProceduralColor, or in a procedural fill "
                "ProceduralTexture.")
        endif()
        if(NOT entries STREQUAL "")
            string(APPEND entries ",")
        endif()
        string(APPEND entries "{\"kind\":\"${kind}\",\"name\":\"${field}\"}")
    endforeach()
endif()
if(textures GREATER 3)
    message(FATAL_ERROR "${SOURCE}: ${struct_name} declares ${textures} textures; declare at most 3 ProceduralTexture fields.")
elseif(textures GREATER 0)
    set(PROFILE fill-texture-v1)
endif()
set(manifest
    "{\"format\":\"tessera-shader-parameters\",\"parameters\":[${entries}],\"profile\":\"${PROFILE}\",\"version\":1}")
# file(WRITE) would translate the newline on Windows; the canonical form ends with one LF. CONFIGURE
# skips an unchanged file, so touch it to stay newer than the inputs of the build step.
file(CONFIGURE OUTPUT "${MANIFEST}" CONTENT "${manifest}\n" @ONLY NEWLINE_STYLE UNIX)
file(TOUCH "${MANIFEST}")
